# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/findit?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/findit

# Authentication Secrets
JWT_SECRET=your_jwt_access_secret_super_secure_and_very_long_key_12345
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_and_very_long_key_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_and_very_long_key_67890
OTP_SECRET=your_otp_hmac_secret_super_secure_and_very_long_key_abcde

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Resend Email Service Configuration
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=FINDIT Security <onboarding@resend.dev>

# Cloudinary Image Hosting Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
